# Copy to .env and fill in. NEVER commit .env.
# Mode: dry_run (default, no orders), paper (Kalshi demo env), live
PMQ_MODE=dry_run

# ---- Kalshi (https://kalshi.com — API keys in account settings) ----
# Auth: RSA-PSS SHA256 request signing. Generate key pair in Kalshi UI, download private key PEM.
KALSHI_API_KEY_ID=
KALSHI_PRIVATE_KEY_PATH=./kalshi_private_key.pem
# Use demo env for paper trading: https://external-api.demo.kalshi.co
KALSHI_USE_DEMO=true

# ---- Polymarket US (https://polymarket.us/developer — requires in-app KYC first) ----
# Auth: Ed25519 request signing. X-PM-Access-Key / X-PM-Timestamp / X-PM-Signature headers.
PMUS_ACCESS_KEY=
PMUS_PRIVATE_KEY_B64=

# ---- Polymarket global (read-only market data; no account needed) ----
# Gamma/CLOB/Data APIs are public. No keys required for the data layer.

# ---- Risk (hard limits enforced by RiskManager) ----
PMQ_MAX_NOTIONAL_PER_MARKET=500
PMQ_MAX_TOTAL_NOTIONAL=2000
PMQ_MAX_DAILY_LOSS=200
PMQ_MIN_EDGE_BPS=150
